[Unit]
Description=Claude Always Open v2.1 — watches claude-remote-control.service, writes status.json, boot alert
After=network-online.target claude-remote-control.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/claude-always-open/claude_always_open_v21.py
Restart=always
RestartSec=10
# No credentials in this unit. The daemon runs as the user; the Claude
# CLI's own subscription sign-in lives on the machine (~/.claude) from
# Taheed's one interactive login. Nothing here listens on any interface.

[Install]
WantedBy=default.target
